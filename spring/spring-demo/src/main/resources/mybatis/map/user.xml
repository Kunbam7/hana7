<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hana4.shop.dao.CustDAO">
    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into User(id, name, mobile, email) values(#{id}, #{name}, #{mobile}, #{email})
    </insert>


    <select id="getUser" resultType="com.hana7.springdemo.dto.User">
        select id, name, mobile, email
        from User
    </select>
</mapper>
